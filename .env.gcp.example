NODE_ENV=production
PORT=4000

# Use your MongoDB Atlas SRV connection string. Atlas must allow the VM static IP.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/b9t9?retryWrites=true&w=majority

# Same-origin production domains. Do not set VITE_SOCKET_URL in this deployment.
CLIENT_ORIGIN=https://b9t9.games,https://www.b9t9.games
# These are build-time public values. Use an unsigned Cloudinary upload preset;
# never put a Cloudinary API secret in VITE_ variables.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_EASYPAISA_RAAST_ID=984046332

# Admin bootstrap. Password must be at least 10 characters.
ADMIN_NAME=B9T9 Admin
ADMIN_EMAIL=admin@b9t9.games
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Optional Google login. Leave blank when not used.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Public application URL used in password-reset emails.
PUBLIC_APP_URL=https://b9t9.games

# SMTP is required for production password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=B9T9 Support <support@b9t9.games>

# WhatsApp support badge. Use country code without +, spaces or dashes.
WHATSAPP_NUMBER=923001234567
WHATSAPP_MESSAGE=Hello, I need support with my B9T9 account.

# NOWPayments crypto deposits. Create the API key and IPN secret in the merchant dashboard.
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=https://b9t9.games/api/payments/nowpayments/ipn
# Keep this operational conversion rate current before enabling the gateway.
NOWPAYMENTS_PKR_PER_USD=
NOWPAYMENTS_PAY_CURRENCIES=btc,eth,ltc,usdttrc20,usdtbsc
