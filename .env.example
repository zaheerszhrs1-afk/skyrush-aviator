PORT=4000
# Comma-separated allowed frontend origins.
CLIENT_ORIGIN=http://localhost:5173,https://b9t9.games
VITE_SOCKET_URL=http://localhost:4000
# Optional unsigned Cloudinary upload configuration for payment receipts.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Optional Easypaisa Raast ID; defaults to the provided 984046332 account.
VITE_EASYPAISA_RAAST_ID=984046332

# Public URL used in password-reset emails.
PUBLIC_APP_URL=http://localhost:5173

# Optional SMTP for password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional WhatsApp support badge. Use country code without + or spaces.
WHATSAPP_NUMBER=
WHATSAPP_MESSAGE=Hello, I need support with my B9T9 account.

# Optional NOWPayments crypto gateway. The callback must be publicly reachable.
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=https://b9t9.games/api/payments/nowpayments/ipn
# Operational PKR per USD conversion rate used to price wallet deposits.
NOWPAYMENTS_PKR_PER_USD=
NOWPAYMENTS_PAY_CURRENCIES=btc,eth,ltc,usdttrc20,usdtbsc
